# AI CAD 桥梁服务方案 — 服务器配置
# 复制此文件为 .env 并修改配置

# ── 数据库 ──
DATABASE_URL=sqlite:///./data/cad_bridge.db

# ── JWT ──
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── 服务器 ──
HOST=0.0.0.0
PORT=8080

# ── 初始管理员账号 ──
# 首次启动自动创建（如果不存在）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_ADMIN_DISPLAY_NAME=管理员

# ── 深色模式主题（前端用） ──
THEME_BG=#1B1C1E
THEME_SIDEBAR=#212327
THEME_PRIMARY=#4F6EF7
